# Окружение: development | test | production
NODE_ENV=development

# Порт, на котором слушает API
PORT=3000

# Подключение к PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/edu_api?schema=public"

# Публичный адрес сайта: проверка Origin для изменяющих запросов, ссылки в письмах
APP_URL="http://localhost:5173"

# Только для `pnpm prisma db seed` — создаёт администратора
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
